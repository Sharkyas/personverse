   "text": "I distrust people.",
   "trait": "A",
   "facet": "A1",
   "reverse": true
  },
  {
   "id": "C1_4",
   "n": 95,
   "text": "I know how to get things done.",
   "trait": "C",
   "facet": "C1",
   "reverse": false
  },
  {
   "id": "N2_4",
   "n": 96,
   "text": "I am not easily annoyed.",
   "trait": "N",
   "facet": "N2",
   "reverse": true
  },
  {
   "id": "E2_4",
   "n": 97,
   "text": "I avoid crowds.",
   "trait": "E",
   "facet": "E2",
   "reverse": true
  },
  {
   "id": "O2_4",
   "n": 98,
   "text": "I do not enjoy going to art museums.",
   "trait": "O",
   "facet": "O2",
   "reverse": true
  },
  {
   "id": "A2_4",
   "n": 99,
   "text": "I obstruct others' plans.",
   "trait": "A",
   "facet": "A2",
   "reverse": true,
   "hint": "You get in the way of what other people are trying to do."
  },
  {
   "id": "C2_4",
   "n": 100,
   "text": "I leave my belongings around.",
   "trait": "C",
   "facet": "C2",
   "reverse": true,
   "sameAs": "C2"
  },
  {
   "id": "N3_4",
   "n": 101,
   "text": "I feel comfortable with myself.",
   "trait": "N",
   "facet": "N3",
   "reverse": true
  },
  {
   "id": "E3_4",
   "n": 102,
   "text": "I wait for others to lead the way.",
   "trait": "E",
   "facet": "E3",
   "reverse": true
  },
  {
   "id": "O3_4",
   "n": 103,
   "text": "I don't understand people who get emotional.",
   "trait": "O",
   "facet": "O3",
   "reverse": true
  },
  {
   "id": "A3_4",
   "n": 104,
   "text": "I take no time for others.",
   "trait": "A",
   "facet": "A3",
   "reverse": true,
   "hint": "You don't make time for other people."
  },
  {
   "id": "C3_4",
   "n": 105,
   "text": "I break my promises.",
   "trait": "C",
   "facet": "C3",
   "reverse": true
  },
  {
   "id": "N4_4",
   "n": 106,
   "text": "I am not bothered by difficult social situations.",
   "trait": "N",
   "facet": "N4",
   "reverse": true,
   "hint": "Awkward moments with people don't worry you."
  },
  {
   "id": "E4_4",
   "n": 107,
   "text": "I like to take it easy.",
   "trait": "E",
   "facet": "E4",
   "reverse": true
  },
  {
   "id": "O4_4",
   "n": 108,
   "text": "I am attached to conventional ways.",
   "trait": "O",
   "facet": "O4",
   "reverse": true,
   "hint": "You like doing things the usual, traditional way."
  },
  {
   "id": "A4_4",
   "n": 109,
   "text": "I get back at others.",
   "trait": "A",
   "facet": "A4",
   "reverse": true,
   "hint": "You take revenge when someone wrongs you."
  },
  {
   "id": "C4_4",
   "n": 110,
   "text": "I put little time and effort into my work.",
   "trait": "C",
   "facet": "C4",
   "reverse": true
  },
  {
   "id": "N5_4",
   "n": 111,
   "text": "I am able to control my cravings.",
   "trait": "N",
   "facet": "N5",
   "reverse": true
  },
  {
   "id": "E5_4",
   "n": 112,
   "text": "I act wild and crazy.",
   "trait": "E",
   "facet": "E5",
   "reverse": false
  },
  {
   "id": "O5_4",
   "n": 113,
   "text": "I am not interested in theoretical discussions.",
   "trait": "O",
   "facet": "O5",
   "reverse": true,
   "hint": "Theoretical means about ideas rather than practical things."
  },
  {
   "id": "A5_4",
   "n": 114,
   "text": "I boast about my virtues.",
   "trait": "A",
   "facet": "A5",
   "reverse": true,
   "hint": "You show off about your good points."
  },
  {
   "id": "C5_4",
   "n": 115,
   "text": "I have difficulty starting tasks.",
   "trait": "C",
   "facet": "C5",
   "reverse": true
  },
  {
   "id": "N6_4",
   "n": 116,
   "text": "I remain calm under pressure.",
   "trait": "N",
   "facet": "N6",
   "reverse": true
  },
  {
   "id": "E6_4",
   "n": 117,
   "text": "I look at the bright side of life.",
   "trait": "E",
   "facet": "E6",
   "reverse": false
  },
  {
   "id": "O6_4",
   "n": 118,
   "text": "I believe that we should be tough on crime.",
   "trait": "O",
   "facet": "O6",
   "reverse": true
  },
  {
   "id": "A6_4",
   "n": 119,
   "text": "I try not to think about the needy.",
   "trait": "A",
   "facet": "A6",
   "reverse": true,
   "hint": "The needy means people who are poor or struggling."
  },
  {
   "id": "C6_4",
   "n": 120,
   "text": "I act without thinking.",
   "trait": "C",
   "facet": "C6",
   "reverse": true
  }
