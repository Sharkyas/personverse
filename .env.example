# Google AI Studio key (https://aistudio.google.com/apikey). Used for Gemma via the Gemini API.
GEMINI_API_KEY=
# Models for the coach, tried in order. Gemma 4 by default; any Gemini model id also works (e.g. gemini-2.5-flash).
AI_MODEL=gemma-4-31b-it,gemma-4-26b-a4b-it,gemma-3-27b-it

# ElevenLabs text-to-speech (https://elevenlabs.io → Profile → API keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# MongoDB Atlas connection string. Leave empty to use the local file store (.data/profiles.json).
MONGODB_URI=
MONGODB_DB=personalityverse
# Tiger Data (TimescaleDB) service URL for the trait tracker's check-ins (console.cloud.timescale.com → your service → Connect).
# Plain Postgres works too. Leave empty to use the local file store (.data/checkins.json).
TIGER_DATABASE_URL=

# Second voice for the "voice note from future you"
ELEVENLABS_FUTURE_VOICE_ID=EXAVITQu4vr4xnSDxMaL
SITE_URL=

# Local Gemma (auto-detected: Ollama on :11434, LM Studio on :1234). Set these only to override.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:12b
# LOCAL_AI_URL=http://127.0.0.1:1234/v1
# LOCAL_AI_TIMEOUT_MS=90000
# LOCAL_AI=off

# Per-visitor limits on AI, voice and saving (protects your API credits). Set to off for load testing.
# RATE_LIMIT=off
